{
	"name": "calculuser",
	"private": true,
	"version": "0.1.0",
	"license": "GPL-3.0",
	"description": "基于 λ 演算与渐进类型理论的工坊建造与逻辑推演解谜游戏",
	"author": "Arimura Romi <biyuehuya@gmail.com>",
	"homepage": "https://github.com/biyuehu/calculuser",
	"repository": {
		"type": "git",
		"url": "https://github.com/biyuehu/calculuser.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"check": "tsc --noEmit",
		"build": "vite build",
		"serve": "vite preview",
		"test": "vitest run",
		"test:levels": "vitest run tests/levels.test.ts tests/typebuild.test.ts",
		"lint": "biome check .",
		"format": "biome format --write .",
		"prepare": "lefthook install",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"tauri:build:portable": "tauri build --no-bundle"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.5",
		"solid-js": "^1.9.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tauri-apps/cli": "^2.12.6",
		"lefthook": "^2.2.3",
		"typescript": "^5.7.3",
		"vite": "^6.1.0",
		"vite-plugin-singlefile": "^2.3.4",
		"vite-plugin-solid": "^2.11.1",
		"vitest": "^3.0.5"
	}
}
